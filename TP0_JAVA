package calculator;

import java.util.Scanner;

public class Calculator {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        //Exercice 2 : affichage du menu
        System.out.println("Please enter the operator:");
        System.out.println("1) add");
        System.out.println("2) substract");
        System.out.println("3) multiply");
        System.out.println("4) divide");
        System.out.println("5) modulo");

        //Exercice 3 : lecture de l'operateur
        int operateur = sc.nextInt();
        
        //Exercice 4 : premiere operande
        System.out.println("Veuillez entrer le premier nombre:");
        int operande1 = sc.nextInt();

        //Exercice 5 : deuxieme operande
        System.out.println("Veuillez entrer le second nombre:");
        int operande2 = sc.nextInt();

        //Exercice 6 : calcul et affichage
        switch (operateur) {
            case 1:
                System.out.println("Le resultat est : " + (operande1 + operande2));
                break;
            case 2:
                System.out.println("Le resultat est : " + (operande1 - operande2));
                break;
            case 3:
                System.out.println("Le resultat est : " + (operande1 * operande2));
                break;
            case 4:
                if (operande2 == 0) {
                    System.out.println("Opération impossible");
                } else {
                    System.out.println("Le resultat est : " + (double) operande1 / operande2);
                }
                break;
            case 5:
                if (operande2 == 0) {
                    System.out.println("Opération impossible");
                } else {
                    System.out.println("Le resultat est : " + (operande1 % operande2));
                }
                break;
        }


        //Exercices 7 et 8 : operateur invalide
        if (operateur < 1 || operateur > 5) {
            System.out.println("Operateur non valide. Veuillez choisir un operateur dans la liste presente");
            System.exit(0); // on arrete le programme
        }


        sc.close();
    }
}
